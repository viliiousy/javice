{
  "version": 2,
  "redirects": [
    {
      "source": "/extension",
      "destination": "/extension.html",
      "permanent": false
    },
    {
      "source": "/ext",
      "destination": "/extension.html",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "javice.vercel.app"
        }
      ],
      "destination": "https://bashy.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mcp/:code",
      "destination": "/api/hub?mcp=:code"
    },
    {
      "source": "/st/callback",
      "destination": "/api/hub?st=cb"
    }
  ],
  "headers": [
    {
      "source": "/img/ex/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/img/exf/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/img/exf/have.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/food.js": {
      "maxDuration": 60
    }
  }
}
