{
  "manifest_version": 3,
  "name": "Bashy 사용량 수집기",
  "version": "1.1.0",
  "description": "로그인된 Claude·ChatGPT·Higgsfield 에서 사용량을 읽어 bashy.app 허브로 보냅니다.",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://higgsfield.ai/*",
    "https://fnf-api-gw.higgsfield.ai/*",
    "https://bashy.app/*"
  ]
}
