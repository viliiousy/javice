{
  "name": "bashy-app",
  "version": "1.0.1",
  "private": true,
  "description": "Bashy 앱 (Capacitor) — iOS·안드로이드. 화면은 번들(www), 서버는 bashy.app",
  "scripts": {
    "www": "node scripts/build-www.mjs",
    "sync": "npm run www && npx cap sync ios",
    "open": "npx cap open ios",
    "sync:android": "npm run www && npx cap sync android && node scripts/patch-android.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.5.17",
    "@capgo/capacitor-speech-recognition": "^8.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "firebase": "^12.6.0"
  }
}
