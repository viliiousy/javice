{
  "appId": "app.bashy",
  "appName": "Bashy",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "includePlugins": [
      "@capacitor-community/text-to-speech",
      "@capacitor-firebase/messaging",
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/geolocation",
      "@capacitor/haptics",
      "@capacitor/local-notifications",
      "@capacitor/screen-orientation",
      "@capacitor/status-bar",
      "@capgo/capacitor-social-login",
      "@capgo/capacitor-speech-recognition"
    ]
  },
  "server": {
    "iosScheme": "capacitor"
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      }
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
